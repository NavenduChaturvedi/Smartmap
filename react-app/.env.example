# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API). The anon key is safe to expose
# in the browser bundle -- it is a public key, and Row Level Security on
# every table is what actually restricts access to a user's own rows.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
